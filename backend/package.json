{
  "name": "pods-backend",
  "version": "0.0.0",
  "type": "module",
  "description": "Backend API for PODS (Predictive Order & Demand Solutions)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "NODE_OPTIONS='--loader ts-node/esm' node seed.ts",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:phase2": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "vitest run",
    "test:contract": "vitest run src/routes/__tests__/authRoutes.contract.test.ts src/routes/__tests__/mlRoutes.contract.test.ts src/openapi/__tests__/spec.test.ts",
    "test:smoke": "npm run lint && npm run test:contract"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "bullmq": "^5.12.9",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "redis": "^4.7.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.10.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.8.2",
    "vitest": "^4.1.0"
  }
}
