# Backend environment variables example
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env with real secrets to version control

# Server Configuration
PORT=3001
NODE_ENV=development
AUTH_SECRET=replace_with_at_least_24_characters
AUTH_TOKEN_TTL_MINUTES=480
REFRESH_TOKEN_TTL_MINUTES=10080

# Forecast queue and scheduler configuration
FORECAST_BATCH_QUEUE_ATTEMPTS=3
FORECAST_BATCH_QUEUE_BACKOFF_MS=5000
FORECAST_BATCH_QUEUE_CONCURRENCY=1
FORECAST_BATCH_HOUR=2
FORECAST_BATCH_MINUTE=0

# Batch maintenance and ML cache TTLs
BATCH_RUN_STALE_MINUTES=45
ML_ANOMALY_CACHE_TTL_SECONDS=120
ML_FORECAST_CACHE_TTL_SECONDS=300
ML_INFO_CACHE_TTL_SECONDS=600

# Digest delivery scheduler
DIGEST_SCHEDULER_POLL_SECONDS=60

# Digest email delivery (required for channel=email)
# DIGEST_SMTP_HOST=smtp.example.com
# DIGEST_SMTP_PORT=587
# DIGEST_SMTP_SECURE=false
# DIGEST_SMTP_USER=mailer_user
# DIGEST_SMTP_PASS=mailer_password
# DIGEST_EMAIL_FROM=no-reply@pods.local

# Optional: force chat timeout override (milliseconds)
# AI_RESPONSE_TIMEOUT_MS=120000

# Database Configuration
# Format: postgresql://username:password@hostname:port/database
# Default for Docker: postgresql://pods_user:pods_password@postgres:5432/pods_db
DATABASE_URL=postgresql://pods_user:pods_password@postgres:5432/pods_db

# AI/ML Integration
# Get your API key from https://aistudio.google.com/app/apikey
# SECURITY: Store actual key in .env.local (not committed to git)
# Leave empty in this file - use environment variables for production
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.1-pro-preview
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_ANOMALY_MODEL=gemini-3-flash-preview

# Frontend Configuration
# URL for CORS allow-list
FRONTEND_URL=http://localhost:3000

# Security Features
# Rate limiting is enabled by default
# Validation is enabled for all HTTP request bodies
# Security headers are sent with all responses
