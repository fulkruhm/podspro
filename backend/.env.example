# Backend environment variables example
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env with real secrets to version control

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# Format: postgresql://username:password@hostname:port/database
# Default for Docker: postgresql://pods_user:pods_password@postgres:5432/pods_db
DATABASE_URL=postgresql://pods_user:pods_password@postgres:5432/pods_db

# Option B (Cloud SQL socket): leave DATABASE_URL empty and set these values.
# CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name
# DB_NAME=pods_db
# DB_USER=pods_user
# DB_PASSWORD=pods_password

# AI/ML Integration
# Get your API key from https://aistudio.google.com/app/apikey
# SECURITY: Store actual key in .env.local (not committed to git)
# Leave empty in this file - use environment variables for production
GEMINI_API_KEY=

# Frontend Configuration
# URL for CORS allow-list
FRONTEND_URL=http://localhost:3000

# Security Features
# Rate limiting is enabled by default
# Validation is enabled for all HTTP request bodies
# Security headers are sent with all responses
